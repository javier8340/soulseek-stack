# Copia este fichero a .env (cp .env.example .env && chmod 600 .env) y rellénalo.
# Solo lo lee instalar.sh; los contenedores reciben la configuración ya generada.
# Se carga con bash: si un valor lleva espacios o símbolos ($ ! ` " espacio…), ponlo entre comillas simples.

# --- Cuenta de Soulseek (usa una distinta de la de Nicotine+: no pueden estar conectadas a la vez)
SLSK_USERNAME=
SLSK_PASSWORD=

# --- Acceso a la web de slskd
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=

# --- Claves de API (déjalas vacías: instalar.sh las genera y las guarda aquí)
SLSKD_API_KEY=
LIDARR_API_KEY=

# --- Rutas en el host (absolutas)
# Biblioteca final, la que organiza Lidarr. slskd la comparte en Soulseek en solo lectura.
MUSIC_DIR=/srv/musica
# Descargas de slskd. Soularr las mueve y Lidarr las importa a MUSIC_DIR.
# Mejor en el mismo sistema de ficheros que MUSIC_DIR (la importación es un mv, no una copia).
DOWNLOADS_DIR=/srv/descargas/soulseek
# Configuración y estado de los tres servicios
DATA_DIR=/srv/soulseek-stack

# --- Red
# Dirección donde se publican las webs (0.0.0.0 = toda la red local, 127.0.0.1 = solo esta máquina)
WEB_BIND=0.0.0.0
SLSKD_HTTP_PORT=5030
LIDARR_PORT=8686
SOULARR_WEBUI_PORT=8265
# Puerto de entrada de Soulseek: ábrelo (TCP) en el router hacia esta máquina
SLSK_LISTEN_PORT=50300

# --- Sistema
TZ=Europe/Madrid
# Pon "z" si el host usa SELinux (Fedora, RHEL…). Vacío en Debian/Ubuntu/Arch.
SELINUX_LABEL=

# --- Imágenes
SLSKD_IMAGE=docker.io/slskd/slskd:latest
# Si la búsqueda de artistas falla por el servidor de metadatos, prueba con :nightly
LIDARR_IMAGE=lscr.io/linuxserver/lidarr:latest
SOULARR_IMAGE=docker.io/mrusse08/soularr:latest

# --- Soularr
# Cada cuántos segundos revisa lo pendiente en Lidarr
SOULARR_INTERVAL=300
# missing = álbumes que faltan; cutoff_unmet = mejorar los que no llegan a FLAC; all = ambos
SOULARR_SEARCH_SOURCE=all
SOULARR_ALBUMS_PER_RUN=10
# Orden de preferencia; solo FLAC
SOULARR_ALLOWED_FILETYPES='flac 24/192,flac 16/44.1,flac'
# Usuarios de Soulseek a ignorar, separados por comas
SOULARR_IGNORED_USERS=
